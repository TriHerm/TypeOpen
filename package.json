{
  "name": "typeopen",
  "version": "0.1.7",
  "description": "Open-source Markdown editor for macOS with a focused live editing experience.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npm run native:run",
    "dev:electron": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "check:clean-room": "node scripts/check-clean-room.mjs",
    "check:electron": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/textbundle.cjs && node --check electron/file-ops.cjs && node --check electron/theme-css.cjs && node --check electron/path-grants.cjs && node --check electron/document-types.cjs && node --check electron/document-reader.cjs && node --check electron/local-image-io.cjs && node --check electron/folder-dialog-hint.cjs",
    "check:native": "xcrun swiftc -typecheck -target arm64-apple-macos13.0 -framework AppKit -framework WebKit -framework UniformTypeIdentifiers native/Sources/*.swift",
    "test:native-security": "node scripts/test-native-security.mjs",
    "test:native-window-drag": "node scripts/test-native-window-drag.mjs",
    "test:native-context-menu": "node scripts/test-native-context-menu.mjs",
    "verify:native": "npm run check:native && npm run test:native-security && npm run test:native-window-drag && npm run test:native-context-menu",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:runtime": "node scripts/audit-runtime.mjs",
    "verify:portable": "npm run check:clean-room && npm run check:electron && npm run typecheck && npm test && npm run build && npm run audit:runtime",
    "verify": "npm run verify:portable && npm run verify:native",
    "start": "npm run native:run",
    "clean:release": "node -e \"require('node:fs').rmSync('release', { recursive: true, force: true })\"",
    "native:build": "npm run build && node scripts/build-native.mjs",
    "native:run": "npm run native:build && open release/native-arm64/TypeOpen.app",
    "native:dmg": "npm run clean:release && npm run native:build && node scripts/create-native-dmg.mjs",
    "native:verify": "node scripts/verify-native-dist.mjs",
    "homebrew:sync": "node scripts/update-homebrew-cask.mjs",
    "pack": "npm run clean:release && npm run native:build",
    "dmg": "npm run native:dmg",
    "verify:dist": "npm run native:verify",
    "pack:electron": "npm run clean:release && npm run build && electron-builder --dir --mac --arm64 --publish never",
    "dmg:electron": "npm run clean:release && npm run build && electron-builder --mac dmg --arm64 --publish never",
    "dmg:electron:universal": "npm run clean:release && npm run build && electron-builder --mac dmg --universal --publish never"
  },
  "keywords": [
    "markdown",
    "editor",
    "wysiwyg",
    "open-source"
  ],
  "author": "TriHerm Labs contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TriHerm/TypeOpen.git"
  },
  "bugs": {
    "url": "https://github.com/TriHerm/TypeOpen/issues"
  },
  "homepage": "https://github.com/TriHerm/TypeOpen#readme",
  "license": "Apache-2.0",
  "type": "module",
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lexical/list": "^0.48.0",
    "@lexical/markdown": "^0.48.0",
    "@lexical/rich-text": "^0.48.0",
    "@lezer/highlight": "^1.2.5",
    "@mdxeditor/editor": "^4.3.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "dompurify": "^3.4.17",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "flowchart.js": "^1.18.0",
    "jsdom": "^30.1.2",
    "katex": "^0.19.0",
    "lexical": "^0.48.0",
    "lucide-react": "^1.54.0",
    "marked": "^18.1.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm-footnote": "^2.1.0",
    "mdast-util-math": "^3.0.0",
    "mdast-util-mdx-jsx": "^3.2.0",
    "mermaid": "^12.1.0",
    "micromark-extension-gfm-footnote": "^2.1.0",
    "micromark-extension-math": "^3.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.triherm.typeopen",
    "productName": "TypeOpen",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "README.md"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mmd",
          "mdown",
          "mkd",
          "mdwn",
          "mdtxt",
          "mdtext",
          "rmarkdown",
          "rmd",
          "apib",
          "qmd",
          "mdx"
        ],
        "name": "Markdown",
        "role": "Editor"
      },
      {
        "ext": [
          "txt",
          "text"
        ],
        "name": "Plain Text",
        "role": "Editor"
      },
      {
        "ext": "textbundle",
        "name": "TextBundle",
        "role": "Editor",
        "isPackage": true
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "13.0",
      "target": "dmg",
      "icon": "build/icon.png",
      "electronLanguages": [
        "en",
        "es"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "TypeOpen-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "TypeOpen ${version}",
      "iconSize": 96,
      "contents": [
        {
          "x": 160,
          "y": 190,
          "type": "file"
        },
        {
          "x": 420,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
