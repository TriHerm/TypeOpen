{
  "name": "typeopen",
  "version": "0.1.0",
  "description": "Open-source Markdown editor for macOS with a focused live editing experience.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "check:clean-room": "node scripts/check-clean-room.mjs",
    "check:electron": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/textbundle.cjs && node --check electron/file-ops.cjs && node --check electron/theme-css.cjs && node --check electron/path-grants.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:runtime": "node scripts/audit-runtime.mjs",
    "verify": "npm run check:clean-room && npm run check:electron && npm run typecheck && npm test && npm run build && npm run audit:runtime",
    "start": "electron .",
    "clean:release": "node -e \"require('node:fs').rmSync('release', { recursive: true, force: true })\"",
    "pack": "npm run clean:release && npm run build && electron-builder --dir --mac --arm64 --publish never",
    "dmg": "npm run clean:release && npm run build && electron-builder --mac dmg --arm64 --publish never",
    "dmg:universal": "npm run clean:release && npm run build && electron-builder --mac dmg --universal --publish never",
    "verify:dist": "node scripts/verify-dist.mjs"
  },
  "keywords": [
    "markdown",
    "editor",
    "wysiwyg",
    "open-source"
  ],
  "author": "TriHerm Labs contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TriHerm/TypeOpen.git"
  },
  "bugs": {
    "url": "https://github.com/TriHerm/TypeOpen/issues"
  },
  "homepage": "https://github.com/TriHerm/TypeOpen#readme",
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@lexical/list": "^0.48.0",
    "@mdxeditor/editor": "^4.3.2",
    "dompurify": "^3.4.16",
    "flowchart.js": "^1.18.0",
    "katex": "^0.19.0",
    "lexical": "^0.48.0",
    "lucide-react": "^1.54.0",
    "marked": "^18.1.0",
    "mdast-util-gfm-footnote": "^2.1.0",
    "mdast-util-math": "^3.0.0",
    "mermaid": "^12.1.0",
    "micromark-extension-gfm-footnote": "^2.1.0",
    "micromark-extension-math": "^3.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.triherm.typeopen",
    "productName": "TypeOpen",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "README.md"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mmd",
          "mdown",
          "mkd",
          "mdwn",
          "mdtxt",
          "mdtext",
          "rmarkdown",
          "rmd",
          "apib",
          "qmd",
          "mdx"
        ],
        "name": "Markdown",
        "role": "Editor"
      },
      {
        "ext": [
          "txt",
          "text"
        ],
        "name": "Plain Text",
        "role": "Editor"
      },
      {
        "ext": "textbundle",
        "name": "TextBundle",
        "role": "Editor",
        "isPackage": true
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "13.0",
      "target": "dmg",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "TypeOpen-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "TypeOpen ${version}",
      "iconSize": 96,
      "contents": [
        {
          "x": 160,
          "y": 190,
          "type": "file"
        },
        {
          "x": 420,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
